{
  "info": {
    "_postman_id": "2371f311-d96d-43ea-90aa-070a851c7dcd",
    "name": "Reto — Faculty (Parte B)",
    "description": "Peticiones para probar el módulo faculty. Ejecuta primero la carpeta Setup (Login llena {{token}}). Después crea una facultad: la variable {{facultyId}} se llena sola. En Asignar programas pega los id que saques de GET /program.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "facultyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "programId1",
      "value": "",
      "type": "string"
    },
    {
      "key": "programId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "programId3",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "id": "9e7c1c28-1cf2-4d52-af73-72aedc3eb640",
          "name": "Login (guarda el token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "auth"
              ]
            },
            "description": "Llena la variable {{token}} con tu usuario admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@icesi.edu.co\",\n  \"password\": \"Admin12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "6c2098e9-360d-4173-b786-a4eab36ddd63",
          "name": "Listar programas (para copiar ids)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/program?limit=10&skip=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "program"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "skip",
                  "value": "0"
                }
              ]
            },
            "description": "De aquí sacas los id que le vas a asignar a la facultad."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Facultad",
      "item": [
        {
          "id": "60be0faa-66a7-4279-8c4a-a647a3243804",
          "name": "Guarda el facultyId automáticamente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j = pm.response.json();",
                  "if (j.id) { pm.collectionVariables.set('facultyId', j.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/faculty",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "faculty"
              ]
            },
            "description": "Request trampa: solo existe para que el script de arriba corra."
          },
          "response": []
        },
        {
          "id": "3e85c60a-9ff8-4ace-b4d8-14ab173c2b61",
          "name": "Crear facultad",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/faculty",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "faculty"
              ]
            },
            "description": "Solo admin. Al responder 201, el script de esta misma carpeta te guarda el id en {{facultyId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ingenieria\",\n  \"code\": \"ING\",\n  \"foundedYear\": 1960\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
